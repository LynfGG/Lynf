# Copy to .env and fill in. .env is ignored by git and must never be committed.
#
# This single file, at the repository root, is loaded automatically by `pnpm dev`
# and by `pnpm --filter @lynf/backend db:migrate` — nothing to export by hand.

# --- Back end ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgres://lynf:lynf@localhost:5432/lynf

# Generate yours at https://developer.riotgames.com — a development key expires
# every 24 hours, so expect to regenerate it daily.
RIOT_API_KEY=

# How long a stored profile is served before Riot is asked again, in seconds.
SUMMONER_PROFILE_TTL_SECONDS=600

# How long stored ranked standings stay fresh, in seconds.
SUMMONER_RANKS_TTL_SECONDS=900

# How long stored champion masteries stay fresh, in seconds.
SUMMONER_MASTERIES_TTL_SECONDS=3600

# --- Tests ---
# NOT read from this file, on purpose: the repository suite empties its tables on
# every run, so a mistaken value here could wipe your development database — the
# suite also refuses any database whose name does not end in _test. Create and
# migrate that database once (see the README), then export the variable for the run:
#   DATABASE_TEST_URL=postgres://lynf:lynf@localhost:5432/lynf_test pnpm test
# Left unset, that suite is skipped rather than failing.

# --- Front end ---
# Read from this root file too. Only VITE_-prefixed variables reach the browser, so
# nothing else here — the Riot key included — is ever bundled.
VITE_API_BASE_URL=http://localhost:3000
