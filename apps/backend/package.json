{
    "name": "@lynf/backend",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "build": "nest build",
        "dev": "nest start --watch --env-file ../../.env",
        "start": "node dist/main",
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:cov": "jest --coverage",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate"
    },
    "dependencies": {
        "@lynf/shared": "workspace:*",
        "@nestjs/common": "^11.1.6",
        "@nestjs/core": "^11.1.6",
        "@nestjs/platform-express": "^11.1.6",
        "@nestjs/swagger": "^11.2.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "drizzle-orm": "^0.45.2",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.10",
        "@nestjs/schematics": "^11.0.8",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.18.8",
        "@types/pg": "^8.15.5",
        "drizzle-kit": "^0.31.5",
        "jest": "^30.2.0",
        "ts-jest": "^29.4.4",
        "typescript": "~6.0.3"
    }
}
